<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@android:color/black"
  android:fitsSystemWindows="false"
  app:consumeSystemWindowsInsets="start|end"
  app:edgeToEdge="true"
  app:fitsSystemWindowsInsets="start|end"
  tools:context="com.absinthe.anywhere_.ui.preview.ActivityPreviewImageActivity">

  <androidx.viewpager2.widget.ViewPager2
    android:id="@+id/view_pager"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

  <LinearLayout
    android:id="@+id/top_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/preview_scrim"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_fitsSystemWindowsInsets="top">

    <TextView
      android:id="@+id/tv_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@android:color/white"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/tv_counter"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:textColor="#B3FFFFFF"
      android:textSize="12sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/bottom_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/preview_scrim"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="4dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_fitsSystemWindowsInsets="bottom">

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_exit"
      style="?attr/borderlessButtonStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:insetTop="0dp"
      android:insetBottom="0dp"
      android:maxLines="1"
      android:minWidth="0dp"
      android:paddingHorizontal="2dp"
      android:text="@string/preview_exit_image"
      android:textColor="@android:color/white"
      android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_prev"
      style="?attr/borderlessButtonStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:insetTop="0dp"
      android:insetBottom="0dp"
      android:maxLines="1"
      android:minWidth="0dp"
      android:paddingHorizontal="2dp"
      android:text="@string/preview_prev_image"
      android:textColor="@android:color/white"
      android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_next"
      style="?attr/borderlessButtonStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:insetTop="0dp"
      android:insetBottom="0dp"
      android:maxLines="1"
      android:minWidth="0dp"
      android:paddingHorizontal="2dp"
      android:text="@string/preview_next_image"
      android:textColor="@android:color/white"
      android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/btn_edit"
      style="?attr/borderlessButtonStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:insetTop="0dp"
      android:insetBottom="0dp"
      android:maxLines="1"
      android:minWidth="0dp"
      android:paddingHorizontal="2dp"
      android:text="@string/preview_edit_card"
      android:textColor="@android:color/white"
      android:textSize="13sp" />

  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
