<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  tools:context=".ui.main.HomePopupActivity">

  <LinearLayout
    android:id="@+id/home_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="12dp"
    android:layout_marginTop="40dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="40dp"
    android:background="@drawable/bg_home_popup"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true"
    android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rv_cards"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:overScrollMode="never"
      android:paddingTop="8dp"
      android:paddingBottom="4dp" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:baselineAligned="false"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="10dp"
      android:paddingTop="2dp"
      android:paddingEnd="10dp"
      android:paddingBottom="8dp">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_popup_fullscreen"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/settings_home_mode_fullscreen"
        android:textColor="@color/colorAccent"
        android:textSize="12sp"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="22dp"
        app:elevation="0dp"
        app:icon="@drawable/ic_home_mode"
        app:iconGravity="textStart"
        app:iconPadding="4dp"
        app:iconSize="16dp"
        app:iconTint="@color/colorAccent" />

      <Space
        android:layout_width="6dp"
        android:layout_height="1dp" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_popup_customize"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/btn_customize"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        app:backgroundTint="@color/colorAccent"
        app:cornerRadius="22dp"
        app:elevation="0dp"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconPadding="4dp"
        app:iconSize="16dp"
        app:iconTint="@android:color/white" />

      <Space
        android:layout_width="6dp"
        android:layout_height="1dp" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_popup_settings"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/home_popup_settings"
        android:textColor="@color/colorAccent"
        android:textSize="12sp"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="22dp"
        app:elevation="0dp"
        app:icon="@drawable/ic_settings_outline"
        app:iconGravity="textStart"
        app:iconPadding="4dp"
        app:iconSize="16dp"
        app:iconTint="@color/colorAccent" />

    </LinearLayout>

  </LinearLayout>

  <FrameLayout
    android:id="@+id/splash_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <ImageView
      android:id="@+id/iv_splash"
      android:layout_width="288dp"
      android:layout_height="288dp"
      android:layout_gravity="center"
      android:contentDescription="@null"
      android:src="@drawable/splash_anim_vector" />

  </FrameLayout>

</FrameLayout>
